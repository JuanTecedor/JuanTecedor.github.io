---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Pill from "../components/Pill.astro";
import Icon from "../components/Icon.astro";
---

<Layout>
	<header class="hero">
		<Hero
			title="Hi! I'm Juan,"
			tagline="Software Engineer with a strong passion for programming and cybersecurity."
		>
			<div class="pills">
				<Pill><Icon icon="virus" size="1.33em" /> Cybersecurity</Pill>
				<Pill><Icon icon="python-file" size="1.33em" /> Python</Pill>
				<Pill><Icon icon="c++-file" size="1.33em" /> C++</Pill>
				<Pill><Icon icon="linux" size="1.33em" />Linux</Pill>
			</div>
		</Hero>
	</header>
</Layout>

<style>
	.hero {
		padding-inline: 2.5rem;
		align-items: none;
		gap: 10rem;
	}

	.pills {
		display: flex;
		flex-direction: row;
		gap: 0.5rem;
	}
</style>
