---
import Layout from "../layouts/Layout.astro";

const WIDTH = 400;
const HEIGHT = 100;
---

<Layout>
    <div class="metronome">
        <canvas width={WIDTH} height={HEIGHT}></canvas>

        <div class="controls">
            <button id="toggle">Start</button>

            <div class="group">
                <label>Beats:</label>
                <div class="beat-buttons">
                    <button class="beat-btn" data-beats="2">2</button>
                    <button class="beat-btn" data-beats="3">3</button>
                    <button class="beat-btn active" data-beats="4">4</button>
                    <button class="beat-btn" data-beats="5">5</button>
                    <button class="beat-btn" data-beats="6">6</button>
                    <button class="beat-btn" data-beats="7">7</button>
                    <button class="beat-btn" data-beats="8">8</button>
                </div>
            </div>

            <div class="group">
                <label for="bpm">BPM:</label>
                <input type="range" id="bpm" min="40" max="240" value="120" />
                <span id="bpm-value">120</span>
                <button id="tap">Tap Tempo</button>
            </div>
        </div>
    </div>
</Layout>

<script>
    const canvas = document.querySelector("canvas");
    const context = canvas.getContext("2d");
    const button = document.getElementById("toggle");
    const bpmSlider = document.getElementById("bpm");
    const bpmValue = document.getElementById("bpm-value");
    const beatButtons = document.querySelectorAll(".beat-btn");
    const tapButton = document.getElementById("tap");

    const WIDTH = 400;
    const HEIGHT = 100;

    let BEATS = 4;
    let BPM = 120;
    let STEP = WIDTH / BEATS;
    let RECT_WIDTH = STEP - 10;
    let RECT_HEIGHT = HEIGHT - 20;

    let currentBeat = 0;
    let running = false;
    let startTime = 0;
    let lastBeat = -1;

    const audioCtx = new AudioContext();

    function playBeatSound(isDownbeat = false) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.frequency.value = isDownbeat ? 880 : 660;
        gain.gain.value = 0.1;

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime + 0.1);
    }

    function drawRectangles(activeIndex = -1) {
        for (let i = 0; i < BEATS; i++) {
            context.fillStyle = i === activeIndex ? "black" : "gray";
            context.fillRect(i * STEP + 5, 10, RECT_WIDTH, RECT_HEIGHT);
        }
    }

    function drawLine(x) {
        context.beginPath();
        context.moveTo(x, 0);
        context.lineTo(x, HEIGHT);
        context.strokeStyle = "white";
        context.lineWidth = 2;
        context.stroke();
    }

    function drawFrame(timestamp) {
        if (!running) return;

        const BEAT_DURATION = (60 / BPM) * 1000;
        const elapsed = timestamp - startTime;
        const totalCycle = BEATS * BEAT_DURATION;
        const cycleProgress = (elapsed % totalCycle) / BEAT_DURATION;

        currentBeat = Math.floor(cycleProgress);
        const progressWithinBeat = cycleProgress % 1;
        const linePosition = currentBeat * STEP + progressWithinBeat * STEP;

        if (currentBeat !== lastBeat) {
            playBeatSound(currentBeat === 0);
            lastBeat = currentBeat;
        }

        context.clearRect(0, 0, WIDTH, HEIGHT);
        drawRectangles(currentBeat);
        drawLine(linePosition);

        requestAnimationFrame(drawFrame);
    }

    function startMetronome() {
        running = true;
        currentBeat = 0;
        lastBeat = -1;
        startTime = performance.now();
        button.textContent = "Stop";
        audioCtx.resume();
        requestAnimationFrame(drawFrame);
    }

    function stopMetronome() {
        running = false;
        button.textContent = "Start";
        currentBeat = 0;
        lastBeat = -1;
        context.clearRect(0, 0, WIDTH, HEIGHT);
        drawRectangles();
    }

    button.addEventListener("click", () => {
        running ? stopMetronome() : startMetronome();
    });

    bpmSlider.addEventListener("input", (event) => {
        const target = event.target as HTMLInputElement;
        BPM = Number(target.value);
        bpmValue.textContent = String(BPM);
    });

    beatButtons.forEach((button) => {
        button.addEventListener("click", () => {
            beatButtons.forEach((b) => b.classList.remove("active"));
            button.classList.add("active");
            BEATS = Number(button.dataset.beats);
            STEP = WIDTH / BEATS;
            RECT_WIDTH = STEP - 10;
            currentBeat = 0;
            context.clearRect(0, 0, WIDTH, HEIGHT);
            drawRectangles();
        });
    });

    let tapTimes = [];
    tapButton.addEventListener("click", () => {
        const now = performance.now();

        if (tapTimes.length && now - tapTimes[tapTimes.length - 1] > 2000) {
            tapTimes = [];
        }

        tapTimes.push(now);

        if (tapTimes.length >= 2) {
            const intervals = [];
            for (let i = 1; i < tapTimes.length; i++) {
                intervals.push(tapTimes[i] - tapTimes[i - 1]);
            }
            const avgInterval =
                intervals.reduce((a, b) => a + b, 0) / intervals.length;
            const newBPM = Math.round(60000 / avgInterval);
            BPM = Math.min(Math.max(newBPM, 40), 240);
            bpmSlider.value = BPM;
            bpmValue.textContent = String(BPM);
        }

        if (tapTimes.length > 5) {
            tapTimes.shift();
        }
    });

    drawRectangles();
</script>

<style>
    .metronome {
        border: 1px solid;
        padding: 10px;
    }

    canvas {
        width: 100%;
    }

    .controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .beat-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .beat-btn {
        background: #444;
        color: white;
        border: none;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .beat-btn.active {
        background: black;
    }

    #toggle,
    #tap {
        background: #333;
        color: white;
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    #toggle:hover,
    #tap:hover {
        background: #555;
    }

    input[type="range"] {
        accent-color: black;
    }
</style>
