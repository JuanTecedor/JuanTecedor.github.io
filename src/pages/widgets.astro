---
import Layout from "../layouts/Layout.astro";

const WIDTH = 800;
const HEIGHT = 200;
---

<Layout>
    <div class="metronome">
        <canvas width={WIDTH} height={HEIGHT}></canvas>

        <div class="controls">
            <button id="toggle">Start</button>

            <div class="group">
                <label>Beats:</label>
                <div class="beat-buttons">
                    <button class="beat-btn">1</button>
                    <button class="beat-btn">2</button>
                    <button class="beat-btn">3</button>
                    <button class="beat-btn active">4</button>
                    <button class="beat-btn">5</button>
                    <button class="beat-btn">6</button>
                    <button class="beat-btn">7</button>
                    <button class="beat-btn">8</button>
                    <button class="beat-btn">9</button>
                </div>
            </div>

            <div class="group">
                <span>BPM:</span>
                <input
                    type="tel"
                    id="bpm-input"
                    min="30"
                    max="256"
                    value="120"
                    step="5"
                    maxlength="3"
                    pattern="\d*"
                    onclick="this.select();"
                />
                <button id="tap">Tap</button>
            </div>

            <div class="group">
                <span>Gain:</span>
                <input
                    type="range"
                    id="gain-slider"
                    min="0"
                    max="1"
                    step="0.01"
                    value="0.2"
                />
            </div>
        </div>
    </div>
</Layout>

<script>
    class Timer {
        readonly WAIT_TIME: number;
        private startTime: DOMHighResTimeStamp;

        constructor(bpm: number) {
            this.WAIT_TIME = (60 / bpm) * 1000;
            this.startTime = performance.now();
        }

        reset(): void {
            this.startTime = performance.now();
        }

        elapsed(): number {
            return performance.now() - this.startTime;
        }

        done(): boolean {
            return this.elapsed() >= this.WAIT_TIME;
        }
    }

    class MetronomeAudio {
        private audioContext: AudioContext;
        private gainNode: GainNode;

        constructor(initialGain = 0.2) {
            this.audioContext = new AudioContext();
            this.gainNode = this.audioContext.createGain();
            this.gainNode.connect(this.audioContext.destination);
            this.gainNode.gain.value = initialGain;
        }

        play(isDownbeat = false): void {
            const oscillator = this.audioContext.createOscillator();
            oscillator.frequency.value = isDownbeat ? 880 : 440;
            oscillator.connect(this.gainNode);
            oscillator.start();
            oscillator.stop(this.audioContext.currentTime + 0.05);
        }

        updateGain(gain: number): void {
            this.gainNode.gain.value = gain;
        }
    }

    class Metronome {
        private audio: MetronomeAudio;
        beats: number;
        bpm: number;
        currentBeat: number;
        running: boolean;
        beatTimer: Timer;

        constructor(
            audio: MetronomeAudio,
            beats: number = 4,
            bpm: number = 120,
        ) {
            this.audio = audio;
            this.beats = beats;
            this.bpm = bpm;
            this.currentBeat = 0;
            this.running = false;
            this.beatTimer = new Timer(bpm);
        }

        start(): void {
            this.running = true;
            this.currentBeat = 0;
            this.beatTimer = new Timer(this.bpm);
            this.audio.play(true);
        }

        stop(): void {
            this.running = false;
        }

        nextBeat(): void {
            this.currentBeat = (this.currentBeat + 1) % (this.beats || 1);
            this.audio.play(this.currentBeat === 0);
            this.beatTimer.reset();
        }

        updateBPM(newBPM: number): void {
            this.bpm = newBPM;
            this.beatTimer = new Timer(newBPM);
        }

        updateBeats(newBeats: number): void {
            this.beats = newBeats;
            this.currentBeat = 0;
        }

        updateGain(newGain: number): void {
            this.audio.updateGain(newGain);
        }
    }

    class Renderer {
        private canvas: HTMLCanvasElement;
        private context: CanvasRenderingContext2D;
        private readonly metronome: Metronome;
        private step: number;
        private rectWidth: number;
        private readonly rectHeight: number;
        private readonly boundFrame: FrameRequestCallback;

        constructor(metronome: Metronome) {
            this.metronome = metronome;
            this.canvas = document.querySelector("canvas") as HTMLCanvasElement;
            this.context = this.canvas.getContext("2d")!;
            this.rectHeight = this.canvas.height - 20;
            this.step = this.canvas.width / metronome.beats;
            this.rectWidth = this.step - 10;
            this.boundFrame = this.drawFrame.bind(this);
        }

        updateDimensions(): void {
            this.step = this.canvas.width / (this.metronome.beats || 1);
            this.rectWidth = this.step - 10;
        }

        private drawRectangles(): void {
            const beats = this.metronome.beats || 1;
            for (let i = 0; i < beats; i++) {
                this.context.fillStyle =
                    i === this.metronome.currentBeat ? "black" : "gray";
                this.context.fillRect(
                    i * this.step + 5,
                    10,
                    this.rectWidth,
                    this.rectHeight,
                );
            }
        }

        private drawLine(x: number): void {
            this.context.beginPath();
            this.context.moveTo(x, 0);
            this.context.lineTo(x, this.canvas.height);
            this.context.strokeStyle = "white";
            this.context.lineWidth = 2;
            this.context.stroke();
        }

        private clear(): void {
            this.context.clearRect(0, 0, this.canvas.width, this.canvas.height);
        }

        drawFrame(): void {
            if (!this.metronome.running) return;

            const progress =
                this.metronome.beatTimer.elapsed() /
                this.metronome.beatTimer.WAIT_TIME;
            const linePosition =
                this.metronome.currentBeat * this.step +
                Math.min(progress, 1) * this.step;

            this.clear();
            this.drawRectangles();
            this.drawLine(linePosition);

            if (this.metronome.beatTimer.done()) {
                this.metronome.nextBeat();
            }

            requestAnimationFrame(this.boundFrame);
        }

        start(): void {
            requestAnimationFrame(this.boundFrame);
        }

        redraw(): void {
            this.clear();
            this.drawRectangles();
        }
    }

    const metronomeAudio = new MetronomeAudio();
    const metronome = new Metronome(metronomeAudio);
    const renderer = new Renderer(metronome);

    const button = document.getElementById("toggle")!;
    const bpmInput = document.getElementById("bpm-input") as HTMLInputElement;
    const gainSlider = document.getElementById(
        "gain-slider",
    ) as HTMLInputElement;
    const beatButtons = document.querySelectorAll(".beat-btn");
    const tapButton = document.getElementById("tap")!;

    const MIN_BPM = Number(bpmInput.min);
    const MAX_BPM = Number(bpmInput.max);

    button.addEventListener("click", () => {
        if (metronome.running) {
            metronome.stop();
            button.textContent = "Start";
        } else {
            metronome.start();
            renderer.start();
            button.textContent = "Stop";
        }
    });

    bpmInput.addEventListener("change", (event) => {
        let bpm = Number((event.target as HTMLInputElement).value);
        if (isNaN(bpm)) {
            return;
        }
        bpm = Math.min(Math.max(bpm, MIN_BPM), MAX_BPM);
        bpmInput.value = String(bpm);
        metronome.updateBPM(bpm);
    });

    gainSlider.addEventListener("input", (event) => {
        const gain = Number((event.target as HTMLInputElement).value);
        metronome.updateGain(gain);
    });

    beatButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            beatButtons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            const beats = Number(btn.textContent);
            metronome.updateBeats(beats);
            renderer.updateDimensions();
            renderer.redraw();
        });
    });

    let tapTimes: number[] = [];
    tapButton.addEventListener("click", () => {
        const now = performance.now();
        if (tapTimes.length && now - tapTimes[tapTimes.length - 1] > 2000)
            tapTimes = [];
        tapTimes.push(now);
        if (tapTimes.length >= 2) {
            const intervals = tapTimes.slice(1).map((t, i) => t - tapTimes[i]);
            const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;
            const newBPM = Math.min(
                Math.max(Math.round(60000 / avg), MIN_BPM),
                MAX_BPM,
            );
            metronome.updateBPM(newBPM);
            bpmInput.value = String(newBPM);
        }
        if (tapTimes.length > 5) tapTimes.shift();
    });

    renderer.redraw();
</script>

<style>
    .metronome {
        border: 1px solid;
        padding: 10px;
    }

    canvas {
        width: 100%;
    }

    .controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .beat-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .beat-btn {
        background: #444;
        color: white;
        border: none;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .beat-btn.active {
        background: black;
    }

    #toggle,
    #tap {
        background: #333;
        color: white;
        padding: 0.3rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    #tap {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    #toggle:hover,
    #tap:hover {
        background: #555;
    }

    input[type="tel"] {
        width: 6ch;
        padding: 0.3rem;
        border: 1px solid #888;
        border-radius: 8px;
        text-align: center;
    }

    input[type="range"] {
        min-width: 0;
        accent-color: black;
        cursor: pointer;
        flex-grow: 1;
    }
</style>
