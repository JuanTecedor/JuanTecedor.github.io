---
import Layout from "../layouts/Layout.astro";

const WIDTH = 800;
const HEIGHT = 200;
---

<Layout>
    <div class="metronome">
        <canvas width={WIDTH} height={HEIGHT}></canvas>

        <div class="controls">
            <button id="toggle">Start</button>

            <div class="group">
                <label>Beats:</label>
                <div class="beat-buttons">
                    <!-- Only plays normal beats -->
                    <button class="beat-btn">0</button>
                    <!-- Only plays downbeat -->
                    <button class="beat-btn">1</button>
                    <!-- Downbeat and rest are normal beats... -->
                    <button class="beat-btn">2</button>
                    <button class="beat-btn">3</button>
                    <button class="beat-btn active">4</button>
                    <button class="beat-btn">5</button>
                    <button class="beat-btn">6</button>
                    <button class="beat-btn">7</button>
                    <button class="beat-btn">8</button>
                    <button class="beat-btn">9</button>
                </div>
            </div>

            <div class="group">
                <label for="bpm">BPM:</label>
                <input type="range" id="bpm" min="30" max="256" value="120" />
                <span id="bpm-value">120</span>
                <button id="tap">Tap Tempo</button>
            </div>
        </div>
    </div>
</Layout>

<script>
    class Timer {
        readonly bpm: number;
        readonly waitTime: number;
        startTime: DOMHighResTimeStamp;

        constructor(bpm: number) {
            this.bpm = bpm;
            this.waitTime = (60 / bpm) * 1_000;
            this.startTime = performance.now();
        }

        reset(): void {
            this.startTime = performance.now();
        }

        elapsed(): DOMHighResTimeStamp {
            return performance.now() - this.startTime;
        }

        done(): boolean {
            return this.elapsed() >= this.waitTime;
        }
    }

    const canvas = document.querySelector("canvas") as HTMLCanvasElement;
    const context = canvas.getContext("2d") as CanvasRenderingContext2D;
    const audioContext = new AudioContext();

    const button = document.getElementById("toggle") as HTMLButtonElement;
    const bpmSlider = document.querySelector("#bpm") as HTMLInputElement;
    const bpmValue = document.querySelector("#bpm-value") as HTMLSpanElement;
    const beatButtons = document.querySelectorAll(
        ".beat-btn",
    ) as NodeListOf<HTMLButtonElement>;
    const tapButton = document.getElementById("tap") as HTMLButtonElement;

    const WIDTH = canvas.width;
    const HEIGHT = canvas.height;

    let BEATS = 4;
    let BPM = 120;
    let STEP = WIDTH / BEATS;
    let RECT_WIDTH = STEP - 10;
    let RECT_HEIGHT = HEIGHT - 20;

    let currentBeat = 0;
    let running = false;
    let beatTimer = new Timer(0);

    function playBeatSound(currentBeat: number, BEATS: number): void {
        const isDownbeat = currentBeat === 0 && BEATS !== 0;
        const osc = audioContext.createOscillator();
        osc.frequency.value = isDownbeat ? 880 : 440;
        const gain = audioContext.createGain();
        gain.gain.value = 0.2;
        osc.connect(gain);
        gain.connect(audioContext.destination);
        osc.start();
        osc.stop(audioContext.currentTime + 0.05);
    }

    function drawRectangles(activeIndex: number = -1): void {
        for (let i = 0; i < (BEATS === 0 ? 1 : BEATS); i++) {
            context.fillStyle = i === activeIndex ? "black" : "gray";
            context.fillRect(i * STEP + 5, 10, RECT_WIDTH, RECT_HEIGHT);
        }
    }

    function drawLine(x: number): void {
        context.beginPath();
        context.moveTo(x, 0);
        context.lineTo(x, HEIGHT);
        context.strokeStyle = "white";
        context.lineWidth = 2;
        context.stroke();
    }

    function drawFrame(): void {
        if (!running) {
            return;
        }

        const BEAT_DURATION = (60 / BPM) * 1_000;
        const progress = beatTimer.elapsed() / BEAT_DURATION;
        const linePosition = currentBeat * STEP + Math.min(progress, 1) * STEP;

        context.clearRect(0, 0, WIDTH, HEIGHT);
        drawRectangles(currentBeat);
        drawLine(linePosition);

        if (beatTimer.done()) {
            currentBeat = (currentBeat + 1) % BEATS;
            playBeatSound(currentBeat, BEATS);
            beatTimer.reset();
        }

        requestAnimationFrame(drawFrame);
    }

    async function startMetronome(): Promise<void> {
        running = true;
        currentBeat = 0;
        beatTimer = new Timer(BPM);
        button.textContent = "Stop";
        await audioContext.resume();
        playBeatSound(currentBeat, BEATS);
        requestAnimationFrame(drawFrame);
    }

    function stopMetronome(): void {
        running = false;
        button.textContent = "Start";
    }

    button.addEventListener("click", () => {
        running ? stopMetronome() : startMetronome();
    });

    bpmSlider.addEventListener("input", (event) => {
        const target = event.target as HTMLInputElement;
        BPM = Number(target.value);
        bpmValue.textContent = String(BPM);
        if (beatTimer) {
            beatTimer = new Timer(BPM);
        }
    });

    beatButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            beatButtons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            BEATS = Number(btn.textContent);
            STEP = WIDTH / (BEATS === 0 ? 1 : BEATS);
            RECT_WIDTH = STEP - 10;
            currentBeat = 0;
            context.clearRect(0, 0, WIDTH, HEIGHT);
            drawRectangles();
        });
    });

    let tapTimes: Array<number> = [];
    tapButton.addEventListener("click", () => {
        const now = performance.now();

        if (tapTimes.length && now - tapTimes[tapTimes.length - 1] > 2_000) {
            tapTimes = [];
        }

        tapTimes.push(now);

        if (tapTimes.length >= 2) {
            const intervals = [];
            for (let i = 1; i < tapTimes.length; i++) {
                intervals.push(tapTimes[i] - tapTimes[i - 1]);
            }
            const avgInterval =
                intervals.reduce((a, b) => a + b, 0) / intervals.length;
            const newBPM = Math.round(60_000 / avgInterval);
            BPM = Math.min(Math.max(newBPM, 40), 240);
            bpmSlider.value = String(BPM);
            bpmValue.textContent = String(BPM);
            if (beatTimer) {
                beatTimer = new Timer(BPM);
            }
        }

        if (tapTimes.length > 5) tapTimes.shift();
    });

    drawRectangles();
</script>

<style>
    .metronome {
        border: 1px solid;
        padding: 10px;
    }

    canvas {
        width: 100%;
    }

    .controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .beat-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .beat-btn {
        background: #444;
        color: white;
        border: none;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .beat-btn.active {
        background: black;
    }

    #toggle,
    #tap {
        background: #333;
        color: white;
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    #tap {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    #toggle:hover,
    #tap:hover {
        background: #555;
    }

    input[type="range"] {
        accent-color: black;
    }
</style>
