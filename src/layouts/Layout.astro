---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string | undefined;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<Head title={title} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
